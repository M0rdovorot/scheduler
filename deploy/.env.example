# Copy to deploy/.env (not committed).

# The domain of the Mini App. Its A record must point at this server.
DOMAIN=

# Database password: any long random string (openssl rand -hex 24).
POSTGRES_PASSWORD=

# Token of the bot from BotFather.
BOT_TOKEN=

# Optional.
# LOG_LEVEL=info
# HTTP_PORT=80
# HTTPS_PORT=443
