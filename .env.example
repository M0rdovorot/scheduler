# Copy to .env (not committed) and adjust.

# dev | prod. DEV_AUTH only works in dev.
APP_ENV=dev

# slog level: debug | info | warn | error
LOG_LEVEL=info

# Address the HTTP API listens on.
HTTP_ADDR=127.0.0.1:8081

# Dev database from docker-compose.dev.yml.
DATABASE_URL=postgres://scheduler:scheduler@127.0.0.1:5433/scheduler?sslmode=disable
