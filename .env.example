# Copy to .env (not committed) and adjust.

# dev | prod. DEV_AUTH only works in dev.
APP_ENV=dev

# slog level: debug | info | warn | error
LOG_LEVEL=info

# Address the HTTP API listens on.
HTTP_ADDR=127.0.0.1:8081

# Dev database from docker-compose.dev.yml.
DATABASE_URL=postgres://scheduler:scheduler@127.0.0.1:5433/scheduler?sslmode=disable

# Sign in without Telegram (POST /api/v1/auth/dev). Only with APP_ENV=dev.
DEV_AUTH=true

# Bot token from BotFather; verifies Mini App init data. Required unless DEV_AUTH=true.
BOT_TOKEN=

# Telegram bot and reminders (long polling). Needs BOT_TOKEN.
# BOT_ENABLED=false
# https:// address of the Mini App; the "Open" buttons of the bot lead there.
# WEBAPP_URL=

# Optional. Go durations.
# SESSION_TTL=720h
# INITDATA_MAX_AGE=24h
